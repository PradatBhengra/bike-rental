# Copy to .env. Every value here is for local development only.
POSTGRES_PASSWORD=bike
JWT_SECRET=change-me-to-a-long-random-string
# Public address Caddy serves. ":8080" = plain HTTP on localhost; a domain name = automatic HTTPS.
SITE_ADDRESS=:8080
APP_URL=http://localhost:8080
COOKIE_SECURE=false

# Razorpay test mode (dashboard.razorpay.com, Test mode -> API keys). Leave the key empty for fake payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret

# LLM providers: console.groq.com/keys and openrouter.ai/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Garage object storage. scripts/garage-init.sh imports this key; any GK + 24 hex / 64 hex pair works.
S3_ACCESS_KEY=GK7cc3e5b897a8deb6add18062
S3_SECRET_KEY=d395ade66211ea95d2048edbd90f184fb7868c6a2a2dcc2fe6a99506875ac8bb
GARAGE_RPC_SECRET=b2bc8c8525c1c103cd9fbecc7fce4932bdec97ff3de0882e5a3b677ae036ea86
GARAGE_ADMIN_TOKEN=cec5748d249993b005da6b590db6e9cf
